# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Groq API key — get yours at https://console.groq.com/keys (free, no credit card)
GROQ_API_KEY=

# AI model used for job parsing and resume enhancement
# See the Config page for available models
LLM_MODEL=llama-3.3-70b-versatile

# Default target currency for salary conversion (ISO 4217, e.g. EUR, USD, GBP)
TARGET_CURRENCY=EUR
