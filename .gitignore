# Dependencies
node_modules/
.next/

# TypeScript build cache
*.tsbuildinfo

# Data (persisted locally, never committed)
data/app.db
data/app.db.wal
*.bak
*.bak.*

# Upload dirs: track folders via .gitkeep only, not user files
data/uploads/resumes/*
!data/uploads/resumes/.gitkeep
data/uploads/adapted/*
!data/uploads/adapted/.gitkeep

# Configuration (contains Groq API key — never commit)
.env
# Keep the dist template committed
!.env.dist
# Legacy config files — kept so existing clones don't accidentally commit them
jobby.config.json
data/jobby.config.json

# OS
.DS_Store
Thumbs.db

# ide
.idea/
